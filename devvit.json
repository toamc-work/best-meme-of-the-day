{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "meme-of-the-day",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "daily-winner": {
        "inline": true,
        "entry": "daily-winner.html"
      },
      "daily-leaderboard": {
        "inline": true,
        "entry": "daily-leaderboard.html"
      },
      "weekly-leaderboard": {
        "inline": true,
        "entry": "weekly-leaderboard.html"
      },
      "weekly-winner": {
        "inline": true,
        "entry": "weekly-winner.html"
      },
      "meme-board": {
        "inline": true,
        "entry": "meme-board.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Meme Post",
        "description": "meme-of-the-day",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create Daily Winner Board",
        "description": "Pin today's meme winner",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/board-daily-winner"
      },
      {
        "label": "Create Daily Leaderboard",
        "description": "Show today's meme rankings",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/board-daily-leaderboard"
      },
      {
        "label": "Create Weekly Battle Board",
        "description": "Weekly competition leaderboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/board-weekly-leaderboard"
      },
      {
        "label": "Create Weekly Champion Board",
        "description": "Show the weekly meme champion",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/board-weekly-winner"
      },
      {
        "label": "Create Meme Board",
        "description": "All-time meme archive",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/board-meme-board"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "meme_of_the_day_dev"
  }
}
